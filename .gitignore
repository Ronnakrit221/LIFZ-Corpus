# =========================================================
# LIFZ Corpus - Keep Small Example Data
# =========================================================

# Allow small example datasets to be committed
!examples/**/*.jsonl
!examples/**/*.json
!examples/**/*.txt

# Allow test fixtures
!tests/fixtures/**/*.jsonl
!tests/fixtures/**/*.json
!tests/fixtures/**/*.txt

# Allow sample dataset
!data/sample/
!data/sample/**

